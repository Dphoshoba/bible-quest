# Example environment variables for local development
# Copy this to a file named `.env` and replace placeholders with real values.
# Never commit your real `.env` with secrets.

# Port your local dev server should run on
PORT=5050

# Stripe secret key (test or live)
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_KEY_HERE

# OpenAI API key
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY

# Optional: Bible API key if used by backend
BIBLE_API_KEY=REPLACE_WITH_YOUR_BIBLE_API_KEY
